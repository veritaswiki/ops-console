{
  "name": "ops-console",
  "version": "2.1.0",
  "type": "module",
  "description": "Self-hostable, zero-dependency control plane for services, AI memory engines, networks, and structured logs.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ops-console": "./bin/ops-console.mjs",
    "ops-probe": "./probe/ops-probe.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "probe/",
    "deploy/",
    "ops-console.config.example.json",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "ops",
    "control-plane",
    "observability",
    "systemd",
    "journald",
    "tailscale",
    "magpie",
    "openviking",
    "nowledge-mem",
    "self-hosted"
  ],
  "scripts": {
    "start": "node bin/ops-console.mjs",
    "demo": "node bin/ops-console.mjs --demo",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
